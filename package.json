{
	"name": "stress",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "firebase emulators:exec --only auth,firestore --project demo-stress --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data --ui \"npm run emulators:seed && npm run dev:app\"",
		"dev:app": "vite",
		"emulators": "firebase emulators:start --only auth,firestore --project demo-stress --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
		"emulators:seed": "node scripts/seed-emulators.mjs",
		"build": "tsc -b && vite build",
		"format": "prettier --write .",
		"check": "prettier --check . && eslint . --max-warnings 0 && npm run build"
	},
	"dependencies": {
		"firebase": "^13.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"firebase-tools": "^15.34.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.3.0"
	}
}
